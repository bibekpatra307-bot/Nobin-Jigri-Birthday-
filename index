<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Happy Birthday Nobin! 🎉</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=Kalam:wght@300;400;700&family=Rozha+One&display=swap" rel="stylesheet">
<style>
  :root {
    --gold: #FFD700;
    --deep-gold: #B8860B;
    --rose: #FF6B9D;
    --deep-rose: #C2185B;
    --cream: #FFF8E7;
    --warm-white: #FFFDF5;
    --dark: #1A0A00;
    --brown: #3E1C00;
    --orange: #FF8C42;
    --purple: #9B59B6;
    --sky: #74B9FF;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--dark);
    color: var(--cream);
    font-family: 'Kalam', cursive;
    overflow-x: hidden;
    cursor: none;
  }

  /* Custom Cursor */
  .cursor {
    width: 20px; height: 20px;
    border: 2px solid var(--gold);
    border-radius: 50%;
    position: fixed;
    pointer-events: none;
    z-index: 9999;
    transition: transform 0.15s ease, border-color 0.3s;
    transform: translate(-50%, -50%);
  }
  .cursor-dot {
    width: 6px; height: 6px;
    background: var(--rose);
    border-radius: 50%;
    position: fixed;
    pointer-events: none;
    z-index: 9999;
    transform: translate(-50%, -50%);
  }

  /* ===== CONFETTI CANVAS ===== */
  #confetti-canvas {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    pointer-events: none;
    z-index: 1000;
  }

  /* ===== HERO SECTION ===== */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    background: radial-gradient(ellipse at 30% 20%, #3E0A0A 0%, #1A0A00 40%, #000508 100%);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(circle at 20% 80%, rgba(255,107,157,0.15) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(255,215,0,0.12) 0%, transparent 50%),
      radial-gradient(circle at 60% 60%, rgba(155,89,182,0.08) 0%, transparent 40%);
  }

  /* Floating particles */
  .particles {
    position: absolute;
    width: 100%; height: 100%;
    overflow: hidden;
  }

  .particle {
    position: absolute;
    border-radius: 50%;
    animation: floatUp linear infinite;
    opacity: 0;
  }

  @keyframes floatUp {
    0% { transform: translateY(100vh) rotate(0deg); opacity: 0; }
    10% { opacity: 0.8; }
    90% { opacity: 0.3; }
    100% { transform: translateY(-100px) rotate(720deg); opacity: 0; }
  }

  .hero-content {
    position: relative;
    z-index: 10;
    text-align: center;
    padding: 2rem;
  }

  .hero-subtitle {
    font-family: 'Kalam', cursive;
    font-size: clamp(1rem, 2.5vw, 1.4rem);
    color: var(--rose);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    animation: fadeInDown 1s ease 0.3s both;
  }

  .hero-name {
    font-family: 'Rozha One', serif;
    font-size: clamp(5rem, 15vw, 13rem);
    line-height: 0.9;
    background: linear-gradient(135deg, #FFD700 0%, #FF8C42 30%, #FF6B9D 60%, #FFD700 100%);
    background-size: 300% 300%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: fadeInUp 1s ease 0.5s both, shimmer 4s ease infinite;
    filter: drop-shadow(0 0 40px rgba(255,215,0,0.4));
    position: relative;
  }

  @keyframes shimmer {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .hero-birthday {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.5rem, 4vw, 3.5rem);
    color: var(--cream);
    font-style: italic;
    margin-top: 0.5rem;
    animation: fadeInUp 1s ease 0.8s both;
    letter-spacing: 0.05em;
  }

  .birthday-highlight {
    color: var(--gold);
    font-style: normal;
    font-weight: 700;
  }

  .hero-emoji-row {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-top: 2rem;
    animation: fadeInUp 1s ease 1s both;
    letter-spacing: 0.5rem;
  }

  .hero-dosti {
    margin-top: 2.5rem;
    font-family: 'Kalam', cursive;
    font-size: clamp(0.9rem, 2vw, 1.2rem);
    color: rgba(255,248,231,0.6);
    animation: fadeInUp 1s ease 1.2s both;
  }

  .scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    animation: bounce 2s ease infinite;
    color: var(--gold);
    font-size: 1.5rem;
    opacity: 0.7;
  }
  @keyframes bounce {
    0%,100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(-10px); }
  }

  @keyframes fadeInDown {
    from { opacity: 0; transform: translateY(-30px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ===== SECTION BASE ===== */
  .section {
    padding: 6rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-title {
    font-family: 'Rozha One', serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    text-align: center;
    margin-bottom: 3rem;
    position: relative;
  }

  .section-title::after {
    content: '';
    display: block;
    width: 80px;
    height: 3px;
    background: linear-gradient(90deg, var(--rose), var(--gold));
    margin: 1rem auto 0;
    border-radius: 2px;
  }

  /* ===== DIVIDER ===== */
  .divider {
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--gold), var(--rose), var(--gold), transparent);
    margin: 0;
    opacity: 0.4;
  }

  /* ===== SHAYRI SECTION ===== */
  .shayri-section {
    background: radial-gradient(ellipse at center, #1a0a1a 0%, #0a0005 100%);
    padding: 5rem 0;
    position: relative;
    overflow: hidden;
  }

  .shayri-section::before {
    content: '❝';
    position: absolute;
    top: -2rem;
    left: 5%;
    font-size: 20rem;
    color: rgba(255,215,0,0.04);
    font-family: serif;
    line-height: 1;
  }

  .shayri-card {
    background: linear-gradient(135deg, rgba(255,215,0,0.07), rgba(255,107,157,0.05));
    border: 1px solid rgba(255,215,0,0.2);
    border-radius: 20px;
    padding: 3rem;
    max-width: 750px;
    margin: 0 auto 2.5rem;
    position: relative;
    backdrop-filter: blur(10px);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  .shayri-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 50px rgba(255,107,157,0.15);
  }

  .shayri-card .quote-mark {
    font-family: 'Playfair Display', serif;
    font-size: 5rem;
    color: var(--gold);
    line-height: 0.5;
    display: block;
    margin-bottom: 1.5rem;
    opacity: 0.6;
  }

  .shayri-text {
    font-family: 'Kalam', cursive;
    font-size: clamp(1.1rem, 2.5vw, 1.5rem);
    line-height: 2.2;
    color: var(--cream);
    text-align: center;
  }

  .shayri-text .line-highlight {
    color: var(--gold);
  }

  .shayri-author {
    text-align: right;
    margin-top: 1.5rem;
    color: var(--rose);
    font-size: 1rem;
    font-style: italic;
  }

  /* ===== MEMORIES / TIMELINE ===== */
  .memories-section {
    background: linear-gradient(180deg, #0a0005 0%, #000a15 50%, #0a0005 100%);
    padding: 5rem 0;
  }

  .timeline {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 2rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0; bottom: 0;
    width: 2px;
    background: linear-gradient(180deg, transparent, var(--gold), var(--rose), var(--gold), transparent);
    transform: translateX(-50%);
  }

  .timeline-item {
    display: flex;
    align-items: center;
    margin-bottom: 4rem;
    position: relative;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .timeline-item.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .timeline-item:nth-child(odd) {
    flex-direction: row-reverse;
  }

  .timeline-dot {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 50px; height: 50px;
    background: linear-gradient(135deg, var(--gold), var(--rose));
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.5rem;
    z-index: 5;
    box-shadow: 0 0 20px rgba(255,215,0,0.5);
    flex-shrink: 0;
  }

  .timeline-content {
    width: 42%;
    background: linear-gradient(135deg, rgba(255,215,0,0.06), rgba(155,89,182,0.06));
    border: 1px solid rgba(255,215,0,0.15);
    border-radius: 16px;
    padding: 1.5rem 2rem;
    position: relative;
  }

  .timeline-item:nth-child(odd) .timeline-content {
    margin-right: 8%;
  }
  .timeline-item:nth-child(even) .timeline-content {
    margin-left: 8%;
  }

  .timeline-year {
    font-family: 'Rozha One', serif;
    font-size: 2rem;
    color: var(--gold);
    display: block;
    margin-bottom: 0.5rem;
  }

  .timeline-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    color: var(--rose);
    margin-bottom: 0.5rem;
  }

  .timeline-desc {
    font-family: 'Kalam', cursive;
    font-size: 1rem;
    color: rgba(255,248,231,0.8);
    line-height: 1.8;
  }

  /* ===== PHOTO GALLERY ===== */
  .gallery-section {
    background: #0a0005;
    padding: 5rem 2rem;
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .photo-card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 4/3;
    cursor: pointer;
    transition: transform 0.4s ease;
    border: 2px solid rgba(255,215,0,0.1);
  }

  .photo-card:hover {
    transform: scale(1.03);
    border-color: var(--gold);
  }

  .photo-card .photo-bg {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 5rem;
    position: relative;
  }

  .photo-card .photo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(0,0,0,0.8) 0%, transparent 50%);
    opacity: 0;
    transition: opacity 0.4s;
    display: flex;
    align-items: flex-end;
    padding: 1.5rem;
  }

  .photo-card:hover .photo-overlay {
    opacity: 1;
  }

  .photo-caption {
    font-family: 'Kalam', cursive;
    color: var(--cream);
    font-size: 0.95rem;
    line-height: 1.5;
  }


  /* ===== BIRTHDAY MESSAGE ===== */
  .message-section {
    background: linear-gradient(135deg, #1a0500 0%, #0a0010 50%, #001a0a 100%);
    padding: 6rem 2rem;
    position: relative;
    overflow: hidden;
  }

  .message-section::before {
    content: '';
    position: absolute;
    top: -50%; left: -50%;
    width: 200%; height: 200%;
    background: conic-gradient(from 0deg at 50% 50%, transparent 0deg, rgba(255,215,0,0.03) 45deg, transparent 90deg, rgba(255,107,157,0.03) 135deg, transparent 180deg, rgba(255,215,0,0.03) 225deg, transparent 270deg, rgba(255,107,157,0.03) 315deg, transparent 360deg);
    animation: spin 30s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .letter-card {
    max-width: 700px;
    margin: 0 auto;
    background: rgba(255,248,231,0.04);
    border: 1px solid rgba(255,215,0,0.2);
    border-radius: 24px;
    padding: 3.5rem;
    position: relative;
    z-index: 1;
    backdrop-filter: blur(5px);
  }

  .letter-card::before {
    content: '✉';
    position: absolute;
    top: -1.5rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 2.5rem;
    background: var(--dark);
    padding: 0 1rem;
  }

  .letter-text {
    font-family: 'Kalam', cursive;
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 2.3;
    color: rgba(255,248,231,0.9);
    text-align: center;
  }

  .letter-text .highlight {
    color: var(--gold);
    font-weight: 700;
  }

  .letter-text .rose {
    color: var(--rose);
  }

  .letter-sign {
    text-align: right;
    margin-top: 2rem;
    font-family: 'Playfair Display', serif;
    font-style: italic;
    color: var(--rose);
    font-size: 1.3rem;
  }

  /* ===== CAKE SECTION ===== */
  .cake-section {
    background: #000508;
    padding: 4rem 2rem;
    text-align: center;
  }

  .cake-wrapper {
    display: inline-block;
    position: relative;
    animation: cakeFloat 3s ease-in-out infinite;
  }

  @keyframes cakeFloat {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-15px); }
  }

  .cake-emoji {
    font-size: 8rem;
    display: block;
    filter: drop-shadow(0 0 30px rgba(255,215,0,0.6));
  }

  .candle-flames {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    font-size: 2rem;
    margin-bottom: -1rem;
    animation: flicker 0.5s ease-in-out infinite alternate;
  }

  @keyframes flicker {
    from { transform: scaleY(1); }
    to { transform: scaleY(1.1) translateY(-3px); }
  }

  .age-badge {
    display: inline-block;
    background: linear-gradient(135deg, var(--gold), var(--orange));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-family: 'Rozha One', serif;
    font-size: clamp(3rem, 10vw, 8rem);
    line-height: 1;
    margin-top: 1.5rem;
    filter: drop-shadow(0 0 20px rgba(255,215,0,0.5));
  }

  .age-text {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1rem, 3vw, 1.8rem);
    color: var(--cream);
    font-style: italic;
    margin-top: 0.5rem;
  }

  /* ===== FOOTER ===== */
  .footer {
    background: var(--dark);
    padding: 3rem 2rem;
    text-align: center;
    border-top: 1px solid rgba(255,215,0,0.15);
  }

  .footer-heart {
    font-size: 3rem;
    animation: heartbeat 1.5s ease-in-out infinite;
    display: inline-block;
  }

  @keyframes heartbeat {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.2); }
  }

  .footer-text {
    font-family: 'Kalam', cursive;
    color: rgba(255,248,231,0.5);
    margin-top: 1rem;
    font-size: 1rem;
  }

  /* ===== STARS BG ===== */
  .stars-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .star {
    position: absolute;
    background: white;
    border-radius: 50%;
    animation: twinkle linear infinite;
  }

  @keyframes twinkle {
    0%, 100% { opacity: 0.2; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.5); }
  }

  /* ===== BALLOON ANIMATION ===== */
  .balloons-container {
    position: fixed;
    bottom: -200px;
    width: 100%;
    pointer-events: none;
    z-index: 500;
    display: flex;
    justify-content: space-around;
  }

  .balloon {
    width: 40px;
    animation: balloonRise linear forwards;
    opacity: 0;
  }

  @keyframes balloonRise {
    0% { transform: translateY(0) rotate(-5deg); opacity: 0; }
    10% { opacity: 1; }
    50% { transform: translateY(-50vh) rotate(5deg); }
    100% { transform: translateY(-110vh) rotate(-5deg); opacity: 0; }
  }

  /* Scrollbar */
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: var(--dark); }
  ::-webkit-scrollbar-thumb { background: linear-gradient(var(--rose), var(--gold)); border-radius: 3px; }

  /* Responsive */
  @media (max-width: 768px) {
    .timeline::before { left: 24px; }
    .timeline-item, .timeline-item:nth-child(odd) { flex-direction: column; align-items: flex-start; padding-left: 70px; }
    .timeline-dot { left: 24px; }
    .timeline-content { width: 100%; }
    .timeline-item:nth-child(odd) .timeline-content,
    .timeline-item:nth-child(even) .timeline-content { margin: 0; }
  }
</style>
</head>
<body>

<div class="cursor" id="cursor"></div>
<div class="cursor-dot" id="cursorDot"></div>

<canvas id="confetti-canvas"></canvas>

<!-- ========== HERO ========== -->
<section class="hero">
  <div class="stars-bg" id="starsContainer"></div>
  <div class="particles" id="particles"></div>
  
  <div class="hero-content">
    <p class="hero-subtitle">✨ Aaj Ka Din Bahut Khaas Hai ✨</p>
    <h1 class="hero-name">NOBIN</h1>
    <p class="hero-birthday">
      <span class="birthday-highlight">Happy</span> Birthday, 
      <span class="birthday-highlight">Jigri Dost!</span>
    </p>
    <div class="hero-emoji-row">🎂 🎉 🎁 🥳 🎊</div>
    <p class="hero-dosti">School se lekar aaj tak — ek hi dost, ek hi yaari 💛</p>
  </div>

  <div class="scroll-hint">↓
    <div class="photo-card" style="background:#111;">
      <img src="data:image/jpeg;base64," style="width:100%;height:100%;object-fit:cover;display:block;border-radius:15px;" loading="lazy"/>
      <div class="photo-overlay">
        <p class="photo-caption">🌙 Raat ke rangeen pal — dono dost ek saath!</p>
      </div>
    </div>

  </div>
</section>

<div class="divider"></div>

<!-- ========== CAKE ========== -->
<section class="cake-section">
  <div class="candle-flames">🕯️🕯️🕯️🕯️🕯️</div>
  <div class="cake-wrapper">
    <span class="cake-emoji">🎂</span>
  </div>
  <div class="age-badge">Happy B'Day!</div>
  <p class="age-text">Yeh din baar baar aaye, har dafa aur khaas ho!</p>
</section>

<div class="divider"></div>

<!-- ========== PHOTO GALLERY ========== -->
<section class="gallery-section">
  <div class="section" style="padding-top:0;padding-bottom:0;">
    <h2 class="section-title" style="color:var(--sky);">📸 Hamare Pal — Photo Album 📸</h2>
    <p style="text-align:center;color:rgba(255,248,231,0.5);margin-bottom:2.5rem;font-size:0.95rem;">
      (Apni photos yahan upload karein — ye placeholder hain)
    </p>
  </div>

  <div class="photo-grid">

    <div class="photo-card" style="background:#111;">
      <img src="data:image/jpeg;base64," style="width:100%;height:100%;object-fit:cover;display:block;border-radius:15px;" loading="lazy"/>
      <div class="photo-overlay">
        <p class="photo-caption">🌿 Dono dost — ek yaadgaar pal</p>
      </div>
    </div>

    <div class="photo-card" style="background:#111;">
      <img src="data:image/jpeg;base64," style="width:100%;height:100%;object-fit:cover;display:block;border-radius:15px;" loading="lazy"/>
      <div class="photo-overlay">
        <p class="photo-caption">🌙 Raat ki roshni mein — hamare rangeen pal</p>
      </div>
    </div>

    <div class="photo-card" style="background:#111;">
      <img src="data:image/png;base64," style="width:100%;height:100%;object-fit:cover;display:block;border-radius:15px;" loading="lazy"/>
      <div class="photo-overlay">
        <p class="photo-caption">📸 Ek aur khoobsurat yaad</p>
      </div>
    </div>

    <div class="photo-card" style="background:#111;">
      <img src="data:image/jpeg;base64," style="width:100%;height:100%;object-fit:cover;display:block;border-radius:15px;" loading="lazy"/>
      <div class="photo-overlay">
        <p class="photo-caption">🌟 Dost hain hum — aur hamesha rahenge</p>
      </div>
    </div>

    <div class="photo-card" style="background:#111;">
      <img src="data:image/jpeg;base64,
